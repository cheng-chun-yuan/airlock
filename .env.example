# ---- Gateway ----
PORT=8787
# PUBLIC_URL=https://….trycloudflare.com   # required when public: the sign-in (SIWE) domain, invite links and cookies use it
GATEWAY_SECRET=change-me            # audit signatures; also signs sessions and seals stored model keys (see below)
# SESSION_SECRET=...                # sign-in cookies (default GATEWAY_SECRET)
# VAULT_KEY=...                     # encrypts each gateway's upstream API keys at rest (default GATEWAY_SECRET)

# ---- Self-serve gateways (sign in with a wallet, create a gateway, invite members, per-member API keys) ----
# Needs ENS on Sepolia (below): each gateway becomes <slug>.<root>, e.g. acme.airlock.eth, owned by its creator.
# PLATFORM_FILE=data/platform.json  # gateways, members, invites (hashed), API keys (hashed)
# PLATFORM_PRIVATE_KEY=0x...        # key that registers under the root (default ENS_PRIVATE_KEY); pays Sepolia gas
# ENS_ROOT_REGISTRY=0x...           # subregistry of the root name (default: registry:root in data/ens-deploy.json)
# SHARED_LOCAL=0                    # don't offer this server's local model to new gateways
# ALLOW_PRIVATE_UPSTREAMS=1         # self-hosted only: let gateways use private/LAN model URLs
# MAX_GATEWAYS_PER_USER=3  NEW_GATEWAYS_PER_HOUR=10  CHAT_PER_HOUR=120  DEMO_CHAT_PER_HOUR=20
# SEPOLIA_RPC_FALLBACKS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org
APPROVAL_TIMEOUT_MS=180000
APPROVAL_SCOPE_MS=600000            # follow-ups in a session reuse an approval (no new entities, risk not higher); 0 = off
DEFAULT_AGENT=contract-agent.agents.acme.eth

# ---- Local model (OpenAI-compatible, e.g. vLLM on the GB10) ----
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
# LOCAL_THINKING=1                  # keep Qwen thinking on (off by default)

# ---- Frontier model (only reached via Egress, with redacted payloads) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5          # default egress model
# CLAUDE_MODELS=claude-sonnet-5,claude-opus-5-5
# Optional: a self-configured OpenAI-compatible upstream instead of Anthropic, e.g. codex-lb
# EGRESS_PROVIDER=openai              # default = Anthropic Messages API
# EGRESS_BASE_URL=http://localhost:2455/v1   # codex-lb (host.docker.internal:2455 from inside Docker)
# EGRESS_API_KEY=sk-clb-...
# EGRESS_MODEL=gpt-5.6-sol             # default model for airlock/* and auto escalation (was CLAUDE_MODEL)
# EGRESS_MODELS=gpt-5.6-sol,gpt-6-sol,gpt-5.5
# The ENS policy must allow it: airlock.models = "gpt-*,claude-*"  (npm run ens -- set <agent> airlock.models "gpt-*,claude-*")

# ---- Redaction & risk ----
ATTACK_TEST=1                       # local model tries to re-identify placeholders; a hit forces high risk (0 = rules only)
# REDACT_LLM=1                      # local model also tags indirect identifiers (extra local call per new message)
# PRESIDIO_URL=http://localhost:5002   # docker compose starts presidio-analyzer
# DICTIONARY_FILE=demo/dictionary.json

# ---- World ID (unset = mock verifier for local dev) ----
# From developer.world.org: app id, RP id and RP signing key (World ID 4.0 needs RP-signed requests)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENV=staging                   # staging works with simulator.worldcoin.org
WORLD_ACTION=airlock-approve        # ONE action for enroll + approve (stable nullifier, see docs/INTEGRATION-NOTES.md)
# World ID for Agents — Human Continuity OIDC (register a client at https://sandbox.auth.world.org/portal)
# WORLD_OIDC_CLIENT_ID=
# WORLD_OIDC_CLIENT_SECRET=
# WORLD_OIDC_ISSUER=https://sandbox.auth.world.org
# WORLD_OIDC_REDIRECT_URI=http://localhost:8787/oidc/callback
COMMITMENT_SALT=change-me           # commitment = keccak256(nullifier || salt)

# ---- ENS v2 on Sepolia (unset = demo/policies.json + data/approvers.json) ----
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ENS_RESOLVER=0x...                # your PermissionedResolver proxy (writes)
# ENS_PRIVATE_KEY=0x...             # gateway key: ROLE_SET_TEXT only on airlock.auditRoot / airlock.approver
# ENS_AUDIT_NAME=audit.acme.eth
# AUDIT_ANCHOR_INTERVAL_MS=600000

# ---- Curvegrid MultiBaas (optional): ENS events pushed to the gateway, indexed change history ----
# MULTIBAAS_URL=https://<deployment>.multibaas.com     # a Sepolia deployment
# MULTIBAAS_API_KEY=...                               # Administrators group
# MULTIBAAS_WEBHOOK_SECRET=...                        # written by `npm run mb:setup`
